package(default_visibility = ["//visibility:public"])

# C library. Platforms without an explicit value are glibc (or not Linux).
constraint_setting(
    name = "libc",
    default_constraint_value = ":glibc",
)

constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

# The target platform of musl builds (`--config=linux_musl`). They run on, and build their tools
# for, the glibc host.
platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":musl",
    ],
)

constraint_setting(name = "sanitizer")

constraint_value(
    name = "sanitizer_address",
    constraint_setting = ":sanitizer",
)

constraint_value(
    name = "sanitizer_thread",
    constraint_setting = ":sanitizer",
)

config_setting(
    name = "sanitizer_thread_linux",
    constraint_values = [
        ":sanitizer_thread",
        "@platforms//os:linux",
    ],
)

platform(
    name = "sanitizer_address_platform",
    constraint_values = [":sanitizer_address"],
    parents = ["@platforms//host"],
)

# Like the address platform, inherits the host's cpu/os: the TSan Rust toolchains in //build/rust
# are defined per host (Linux x86_64, macOS arm64) and selected by toolchain resolution.
platform(
    name = "sanitizer_thread_platform",
    constraint_values = [":sanitizer_thread"],
    parents = ["@platforms//host"],
)
